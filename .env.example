# Expo env vars. EXPO_PUBLIC_* are exposed to client code at build time.
# EAS build profiles (see eas.json) map APP_ENV -> dev|staging|prod.

APP_ENV=dev
EXPO_PUBLIC_BASE_URL=https://jsonplaceholder.typicode.com
EXPO_PUBLIC_USE_FAKE_API=true
EXPO_PUBLIC_USE_FAKE_DB=true
EXPO_PUBLIC_ENABLE_LOGS=true
EXPO_PUBLIC_API_SCENARIO=success
EXPO_PUBLIC_DB_SCENARIO=success
